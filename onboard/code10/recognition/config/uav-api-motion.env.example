# Install as /etc/uav-api-motion.env, root-owned and mode 0600.
# The motion API must accept OpenAI-compatible Chat Completions over HTTPS.
UAV_MOTION_API_URL=https://api.deepseek.com/chat/completions
UAV_MOTION_API_MODEL=deepseek-flash
UAV_MOTION_API_KEY=
# Optional existing network proxy. Omit when HTTPS is directly reachable.
# HTTPS_PROXY=http://127.0.0.1:18080
