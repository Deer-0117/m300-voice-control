[Unit]
Description=Restricted Natural-Language Command Gateway for UAV Balloon Mission
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/uav/offline_balloon_strike_test
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/uav-natural-language.env
ExecStart=/home/uav/offline_balloon_strike_test/yolo_env/bin/python /home/uav/offline_balloon_strike_test/uav_natural_language.py --serve
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=full
ProtectHome=false

[Install]
WantedBy=multi-user.target
