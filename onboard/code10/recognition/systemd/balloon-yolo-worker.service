[Unit]
Description=Persistent YOLO Worker for Balloon Detection
After=local-fs.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/uav/offline_balloon_strike_test
Environment=PYTHONUNBUFFERED=1
Environment=BALLOON_NL_HIT_ARM_AREA_RATIO=0.015
Environment=BALLOON_NL_HIT_ARM_CONFIRM_FRAMES=2
Environment=BALLOON_NL_HIT_MISSING_CONFIRM_MS=650
Environment=BALLOON_NL_ALLOW_TARGET_DEFER=0
Environment=BALLOON_NL_TARGET_SEARCH_TIMEOUT_MS=90000
Environment=BALLOON_NL_COLOR_OBSERVATION_CACHE_MS=1500
Environment=BALLOON_TARGET_ACQUIRE_CONFIDENCE=0.45
Environment=BALLOON_TARGET_CONTINUE_CONFIDENCE=0.25
Environment=BALLOON_TARGET_LOCK_MAX_JUMP_NORM=0.12
Environment=BALLOON_TARGET_SWITCH_CLUSTER_RADIUS_NORM=0.08
Environment=BALLOON_TARGET_SWITCH_CONFIRM_FRAMES=3
Environment=BALLOON_TARGET_LOCK_EXPIRE_MS=2200
Environment=BALLOON_FAR_TILE_ENABLED=1
Environment=BALLOON_FAR_TILE_LOCK_GRACE_MS=700
Environment=BALLOON_FAR_ACQUIRE_CONFIDENCE=0.35
Environment=BALLOON_FAR_CONFIRM_MAX_AREA_RATIO=0.003
Environment=BALLOON_FAR_MIN_COLOR_CONFIDENCE=0.55
Environment=BALLOON_FAR_CONFIRM_RADIUS_NORM=0.08
Environment=BALLOON_FAR_CONFIRM_FRAMES=2
ExecStart=/home/uav/offline_balloon_strike_test/yolo_env/bin/python /home/uav/offline_balloon_strike_test/balloon_yolo_worker.py --poll-ms 10
Restart=always
RestartSec=2
KillMode=control-group
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
