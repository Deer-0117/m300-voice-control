# Constrained planner service: model output is validated against the capability
# schema and cannot contain velocity, attitude, altitude, or joystick values.
[Unit]
Description=Microsoft Agent Framework UAV Capability Planner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uav
Group=uav
WorkingDirectory=/opt/uav-microsoft-agent/app
Environment=PYTHONUNBUFFERED=1
# Optional env files hold local proxy settings and secrets outside Git.
EnvironmentFile=-/etc/uav-relay-proxy.env
EnvironmentFile=-/etc/uav-code12-proxy.env
EnvironmentFile=-/etc/uav-microsoft-agent.env
ExecStart=/opt/uav-microsoft-agent/venv/bin/python /opt/uav-microsoft-agent/app/uav_microsoft_agent.py --serve
Restart=always
RestartSec=3
NoNewPrivileges=true
# Hardening still permits the dedicated state directory required by the service.
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/var/lib/uav-microsoft-agent

[Install]
WantedBy=multi-user.target
