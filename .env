# Fill in your own key here. Never commit or share a real key.
OPENAI_API_KEY=Your API Key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_CHAT_MODEL_ID=deepseek-flash
UAV_API_TIMEOUT_S=30
UAV_MAX_VISUAL_DECISIONS=100
# 0: observe real inputs and generate candidates; 1: allow PSDK bridge to execute.
# PSDK process also requires M300_ALLOW_FLIGHT=1 and RC Prepare + Confirm.
UAV_ENABLE_FLIGHT=0
UAV_STATE_DIR=state
UAV_WHISPER_CLI=third_party/whisper.cpp/build/bin/whisper-cli
UAV_WHISPER_MODEL=third_party/whisper.cpp/models/ggml-base.bin
UAV_LIVEVIEW_METADATA=inputs/liveview_latest.tsv
UAV_LIVEVIEW_FRAME_DIR=inputs/liveview_frames
UAV_CAMERA_DESCRIPTION=Forward-facing level camera. Confirm physical mounting, fixed zoom and gimbal yaw/pitch before movement.
